# Flask & App Settings
FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=your-flask-secret-key

# MySQL Database Settings (Docker MySQL)
DATABASE_URL=mysql+pymysql://root:123456@localhost:3306/modern_board_db

# JWT Authentication
JWT_SECRET_KEY=your-jwt-secret-key-at-least-32-chars
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=1440

# Server Port
PORT=5000
